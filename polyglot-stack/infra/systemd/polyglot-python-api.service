[Unit]
Description=Polyglot Stack - Python Compute & Analytics API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=polyglot-py
Group=polyglot-py
WorkingDirectory=/opt/polyglot-python-api/current
EnvironmentFile=/etc/polyglot-python-api/python-api.env
ExecStart=/opt/polyglot-python-api/current/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT} --workers 2
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
